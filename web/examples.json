      "op": "json_to_soap",
      "label": "JSON to SOAP",
      "help": "Values are XML-escaped, so a < or & in data cannot break the envelope. Try a key like a><b: it is refused.",
      "input": {
        "operation": "UpdateCustomerNote",
        "namespace": "urn:acme:crm:v1",
        "params": {
          "CustomerId": "C-1001",
          "Note": "Ships <Tue> & <Thu> only",
          "Tags": {
            "Tag": [
              "vip",
              "net-30"
            ]
          }
        }
