    {
      "op": "retry_plan",
      "label": "Retry plan",
      "help": "Upstream answers 503, 503, 429 with Retry-After 2 s, then 200. Waits use full-jitter exponential backoff, except where the server says how long to wait.",
      "input": {
        "responses": [
          503,
          503,
          {
            "status": 429,
            "retry_after_s": 2
          },
          200
        ],
        "base_ms": 250,
        "max_backoff_ms": 8000,
        "deadline_ms": 20000,
        "seed": 7
      }
    },
    {
      "op": "odata_query",
      "label": "SAP OData query",
      "help": "An agent asks for a customer's open orders. The customer value tries to inject an OR clause; it stays a quoted literal. top is capped at 100.",
      "input": {
        "service_url": "https://sap.acme.internal/sap/opu/odata/sap/API_SALES_ORDER_SRV",
        "entity_set": "A_SalesOrder",
        "select": [
          "SalesOrder",
          "SoldToParty",
          "TotalNetAmount",
          "OverallSDProcessStatus"
        ],
        "filters": [
          {
            "field": "SoldToParty",
            "op": "eq",
            "value": "10042' or SoldToParty ne '"
          },
          {
            "field": "OverallSDProcessStatus",
            "op": "eq",
            "value": "A"
          }
        ],
        "top": 5000
      }
